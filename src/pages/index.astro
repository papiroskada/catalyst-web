---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import WordsToSystem from '../components/WordsToSystem.astro';
import { HOME_FAQ, WORDS } from '../data/content';
import { website, faqPage } from '../lib/schema';
---
<Base
  title="Custom operations software for small businesses | Catalyst"
  description="We build one working system around how your company already runs: orders, materials, production and delivery in one place. First version in weeks, changed whenever you need."
  overlayHeader
  contactFormOnPage
  jsonLd={[website(), faqPage(HOME_FAQ)]}
>
  <canvas id="gl" aria-hidden="true"></canvas>

  <section class="hero" id="hero">
    <div class="copy"><div class="copy-in" id="copy">
      <h1>Software made to measure</h1>
      <p class="lede">We build one operations system around how your company already runs, then keep shaping it as you grow.</p>
      <div class="actions"><a class="btn" href="#contact">Get in touch</a></div>
    </div></div>
  </section>

  <WordsToSystem />

  <section class="sec words" id="words" aria-labelledby="words-h"><div class="wrap">
    <div class="words-head"><h2 id="words-h">Your words. Your flow.</h2><p class="wsub">We shape the system around you. A few examples of how that looks:</p></div>
    <div class="wstack">
      {WORDS.map((w, i) => (
        <article class="wcard" style={`--i:${i}`}>
          <div class="wc-text">
            <h3>{w.title}</h3>
            <p class="wc-d">{w.text}</p>
            <ul class="wc-chips" aria-label="Words this team uses">
              {w.chips.map(([ic, label]) => <li><Icon name={ic} sw={1.6} /><span>{label}</span></li>)}
            </ul>
            <a class="wc-cta" href={w.href}><span class="wc-arr" aria-hidden="true"><Icon name="chev" sw={2} /></span>{w.cta}</a>
          </div>
          <div class:list={['wc-panel', w.panel]}>
            <Image src={w.img} alt={w.alt} widths={[480, 760, 1140]} sizes="(max-width: 980px) 92vw, 640px" loading="lazy" />
          </div>
        </article>
      ))}
    </div>
    <!-- phones: the cards become a swipeable row; these dots show and pick the current one -->
    <div class="wdots" aria-label="Examples">
      {WORDS.map((w, i) => <button type="button" aria-label={`Show example ${i + 1}: ${w.title}`} aria-current={i === 0 ? 'true' : undefined} data-i={i} />)}
    </div>
  </div></section>

  <section class="sec build" id="build" aria-labelledby="build-h"><div class="wrap">
    <div class="bhead"><h2 id="build-h">Then we build it and run it your way.</h2></div>
    <div class="bgrid">
      <article class="bcard"><h3>A first version in weeks</h3><p>We start with the part that slows you down most, then add the rest step by step. Your team uses it from early on and tells us what to change.</p><span class="bi"><Icon name="bolt" /></span></article>
      <article class="bcard"><h3>Changes whenever you need</h3><p>A new step, a new status, a new report. Tell us, and we adjust the system as your business changes. No starting over.</p><span class="bi"><Icon name="sliders" /></span></article>
      <article class="bcard"><h3>Hosted where you prefer</h3><p>On your own servers or with us. We set it up and look after security, updates and backups.</p><span class="bi"><Icon name="server" /></span></article>
      <article class="bcard"><h3>Support around the clock</h3><p>Help is available 24/7, from people who know your system and your team by name.</p><span class="bi"><Icon name="headset" /></span></article>
    </div>
    <p class="more"><a class="link" href="/how-we-work/">More on how we work and how pricing works</a></p>
  </div></section>

  <Faq items={HOME_FAQ} />
  <Contact form />
</Base>

<style>
  #gl { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 30; pointer-events: none; display: block }
  .hero { position: relative; margin: 0 var(--side); border-radius: 0 0 var(--r-lg) var(--r-lg); overflow: hidden; background: radial-gradient(ellipse 55% 45% at 50% 46%, color-mix(in srgb, var(--bloom) 70%, transparent), transparent 72%), linear-gradient(135deg, var(--g1) 0%, var(--g2) 52%, var(--g3) 100%) }
  .copy { position: relative; z-index: 35; display: flex; justify-content: center; text-align: center; padding-inline: 24px; padding-block: calc(clamp(140px, 21vh, 210px) + var(--hh) + env(safe-area-inset-top, 0px)) clamp(110px, 15vh, 160px); pointer-events: none }
  .copy-in { max-width: 760px; pointer-events: auto; display: flex; flex-direction: column; align-items: center }
  .hero h1 { font-size: clamp(42px, 6vw, 92px); line-height: 1; letter-spacing: -.025em }
  .hero .lede { color: var(--ink-2) }
  .hero .lede { max-width: 44ch }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; align-items: center; margin-top: 36px }



  .words { --wh: calc(clamp(32px, 4vw, 56px) * 1.04 + 40px); background: var(--soft); padding-top: clamp(72px, 9vh, 110px) }
  .wsub { margin: 10px 0 0; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.35; color: var(--mid) }
  .words-head { position: sticky; top: calc(var(--hh) + 28px); margin-bottom: 36px; z-index: 0 }
  .wstack { display: flex; flex-direction: column; gap: 28px; padding-bottom: 40px }
  .wcard { position: sticky; z-index: 1; top: calc(var(--hh) + 28px + var(--wh) + 36px + var(--i) * 16px); display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 40px; min-height: min(560px, calc(100vh - var(--hh) - var(--wh) - 140px)); padding: 44px; border-radius: 32px; background: var(--surface); box-shadow: 0 -18px 40px color-mix(in srgb, var(--navy) 6%, transparent); transform-origin: 50% 0 }
  .wc-text { display: flex; flex-direction: column; gap: 18px; min-width: 0 }
  .wcard h3 { font: 600 clamp(24px, 2.2vw, 32px)/1.2 var(--body); letter-spacing: -.01em }
  .wc-d { margin: 0; font-size: 17px; line-height: 1.6; color: var(--body-ink); max-width: 44ch }
  .wc-chips { list-style: none; margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 10px }
  .wc-chips li { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px 10px 14px; border: 1px solid color-mix(in srgb, var(--ink) 6%, transparent); border-radius: 999px; font-size: 15px }
  .wc-chips :global(svg) { width: 20px; height: 20px; color: var(--navy) }
  .wc-cta { margin-top: auto; display: inline-flex; align-items: center; gap: 12px; font-weight: 500; font-size: 16px; text-decoration: none; align-self: flex-start }
  .wc-arr { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--navy); color: var(--surface); transition: transform .3s }
  .wc-arr :global(svg) { width: 16px; height: 16px }
  .wc-cta:hover .wc-arr { transform: translateX(4px) }
  .wc-panel { position: relative; border-radius: 24px; overflow: hidden; min-height: 380px }
  .wc-panel :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: left top }

  .build { padding-top: clamp(150px, 22vh, 240px) }
  .more { margin: 40px 0 0 }
  .wdots { display: none }

  @media (max-width: 980px) {
    .wcard { grid-template-columns: minmax(0, 1fr); padding: 28px; top: calc(var(--hh) + 28px + var(--wh) + 36px + var(--i) * 10px) }
    .wc-chips { flex-direction: row; flex-wrap: wrap }
    .wc-panel { min-height: 300px }
  }
  /* phones: hero runs edge to edge (no side gaps); much tighter gaps between sections */
  @media (max-width: 640px) {
    .hero { margin: 0 }
    .sec.build { padding-top: 80px !important } /* follows the tinted "Your words" band: full gap from its edge */
    .wstack { padding-bottom: 0 }
    /* "Your words" cards: one swipeable row with snap, one full-width card at a time; the dots show which */
    .words-head { position: static }
    .wstack { flex-direction: row; gap: 32px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory;
      margin-inline: -24px; padding-inline: 24px; scroll-padding-inline: 24px; scrollbar-width: none }
    .wstack::-webkit-scrollbar { display: none }
    .wcard { position: relative; top: 0; flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always; box-shadow: none;
      transform-origin: 50% 50%; filter: none !important }
    /* card layout on phones: text, compact chips, photo, then the link under the photo */
    .wcard { display: flex; flex-direction: column; gap: 16px; padding: 24px }
    .wc-text { display: contents }
    .wcard h3 { order: 0 } .wc-d { order: 1 } .wc-chips { order: 2 } .wc-panel { order: 3; margin-top: 4px } .wc-cta { order: 4; margin-top: 4px }
    .wc-chips { gap: 6px; margin-top: 0 }
    .wc-chips li { gap: 6px; padding: 6px 12px 6px 10px; font-size: 13px }
    .wc-chips :global(svg) { width: 16px; height: 16px }
    .wdots { display: flex; justify-content: center; gap: 8px; margin-top: 20px }
    .wdots button { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 999px; background: color-mix(in srgb, var(--navy) 22%, transparent); cursor: pointer; transition: background-color .3s }
    .wdots button[aria-current] { width: 24px; background: var(--navy) }
  }
  @media (max-width: 560px) { .words-head { position: static } .wcard { position: relative; top: 0 } .wc-panel { min-height: 240px } }
</style>

<script>
  // Cards stick just below the sticky "Your words" heading. Its real height (the subtitle can wrap)
  // is measured here, so a card can never slide over the heading.
  const wordsSec = document.getElementById('words');
  const wordsHead = wordsSec?.querySelector<HTMLElement>('.words-head');
  if (wordsSec && wordsHead) {
    const setWh = () => wordsSec.style.setProperty('--wh', `${wordsHead.offsetHeight}px`);
    new ResizeObserver(setWh).observe(wordsHead);
    setWh();

    // At the end of the section the cards stop sticking before the heading does, and would slide
    // over it. Move the heading up by the same distance so it leaves together with the cards.
    const cards = Array.from(wordsSec.querySelectorAll<HTMLElement>('.wcard'));
    const follow = () => {
      if (getComputedStyle(cards[0]).position !== 'sticky') { wordsHead.style.transform = ''; return; }
      // Keep the heading's bottom at least one gap above the highest card.
      const gap = parseFloat(getComputedStyle(wordsHead).marginBottom);
      const topCard = Math.min(...cards.map((c) => c.getBoundingClientRect().top));
      const cur = new DOMMatrix(getComputedStyle(wordsHead).transform).m42;
      const naturalBottom = wordsHead.getBoundingClientRect().bottom - cur;
      const shift = Math.min(0, topCard - gap - naturalBottom);
      wordsHead.style.transform = shift ? `translateY(${shift}px)` : '';
    };
    // Runs in the scroll handler itself (not a later frame) so the heading never lags a frame behind.
    addEventListener('scroll', follow, { passive: true });
    addEventListener('resize', follow);
    follow();
  }
  // Orbiting ticks around the hero copy, clipped to the hero panel. Skipped for reduced motion.
  const INK = getComputedStyle(document.documentElement).getPropertyValue('--navy').trim();
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('gl') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const hero = document.getElementById('hero')!;
  const copy = document.getElementById('copy')!;
  const hdr = document.getElementById('hdr')!;
  const TAU = Math.PI * 2;
  const clamp = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x);
  const CIRC = Array.from({ length: 56 }, (_, i) => ({ b: (i / 56) * TAU, long: i % 4 === 0 }));
  let W = 1, H = 1, dpr = 1;
  const resize = () => {
    W = innerWidth; H = innerHeight; dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
  };
  addEventListener('resize', resize);
  resize();

  let T = 0, theta = 0, last = performance.now();
  function frame(now: number) {
    requestAnimationFrame(frame);
    const dt = Math.min((now - last) / 1000, 1 / 20); last = now;
    const hb = hdr.offsetHeight, hr = hero.getBoundingClientRect();
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, W, H);
    if (hr.bottom <= hb) return;
    const p = clamp(scrollY / (hero.offsetHeight * 0.7));
    copy.style.opacity = String(1 - clamp(p * 1.6));
    copy.style.transform = `translateY(${-p * 40}px)`;
    let R2 = parseFloat(getComputedStyle(hero).borderBottomLeftRadius) || 0;
    const L = hr.left, Rt = hr.right, Tp = Math.max(hr.top, hb), Bt = hr.bottom;
    R2 = Math.min(R2, Math.max(0, Bt - Tp) / 2);
    canvas.style.clipPath = Bt > Tp ? `path('M${L} ${Tp}H${Rt}V${Bt - R2}A${R2} ${R2} 0 0 1 ${Rt - R2} ${Bt}H${L + R2}A${R2} ${R2} 0 0 1 ${L} ${Bt - R2}Z')` : "path('M0 0Z')";
    if (!RM) { T += dt; theta += 0.1 * dt; }
    const cr = copy.getBoundingClientRect(), cx = W / 2, cy = cr.top + cr.height * 0.4;
    const rx = Math.min(cr.width / 2 + (W < 820 ? 20 : 110), W / 2 - 10);
    const R = W < 640 ? Math.max(W * 0.62, cr.height * 0.52) : Math.min(rx * 0.9, W / 2 - 10);
    const TA = W < 640 ? 0.32 : 0.82, sLen = W < 820 ? 12 : 16, lLen = W < 820 ? 22 : 30;
    ctx.strokeStyle = INK; ctx.lineWidth = 2.4; ctx.globalAlpha = TA;
    for (let i = 0; i < CIRC.length; i++) {
      const t = CIRC[i];
      const len = t.long ? lLen * (1 + 0.32 * Math.pow(Math.max(0, Math.sin(T * 0.45 + i * 2.39)), 10)) : sLen;
      const ph = t.b - theta, c = Math.cos(ph), s = Math.sin(ph), ox = cx + c * R, oy = cy - s * R;
      ctx.beginPath(); ctx.moveTo(ox + c * 2, oy - s * 2); ctx.lineTo(ox + c * (2 + len), oy - s * (2 + len)); ctx.stroke();
    }
    ctx.globalAlpha = 1;
  }
  requestAnimationFrame(frame);

  // "Your words": covered cards recede slightly as the next one slides over.
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.wcard'));
  if (!RM && cards.length) {
    const upd = () => {
      if (getComputedStyle(cards[0]).position !== 'sticky') return; // phones: cards are a swipeable row (below)
      for (let i = 0; i < cards.length - 1; i++) {
        const r = cards[i].getBoundingClientRect(), n = cards[i + 1].getBoundingClientRect();
        const k = clamp((r.bottom - n.top) / r.height);
        cards[i].style.transform = `scale(${(1 - 0.04 * k).toFixed(4)})`;
        cards[i].style.filter = `brightness(${(1 - 0.04 * k).toFixed(3)})`;
      }
    };
    addEventListener('scroll', upd, { passive: true });
    addEventListener('resize', upd);
    upd();
  }

  // Phones: "Your words" cards as a swipeable row. Cards away from the left edge sit a little smaller and
  // dimmer and grow into place as they snap in; the dots follow the current card and jump to one on tap.
  const row = document.querySelector<HTMLElement>('.wstack');
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.wdots button'));
  if (row && cards.length) {
    const phone = matchMedia('(max-width: 640px)');
    let cur = 0, rf = 0;
    const paintRow = () => {
      rf = 0;
      if (!phone.matches) { cards.forEach((c) => { c.style.opacity = ''; c.style.transform = ''; }); return; }
      const start = row.getBoundingClientRect().left + parseFloat(getComputedStyle(row).scrollPaddingLeft || '0');
      let best = 0, bestD = Infinity;
      cards.forEach((c, i) => {
        const r = c.getBoundingClientRect();
        const d = Math.min(1, Math.abs(r.left - start) / r.width); // 0 = in place, 1 = a full card away
        if (d < bestD) { bestD = d; best = i; }
        if (!RM) c.style.transform = `scale(${(1 - 0.06 * d).toFixed(4)})`;
        c.style.opacity = (1 - 0.35 * d).toFixed(3);
      });
      if (best !== cur) {
        cur = best;
        dots.forEach((d, i) => (i === cur ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      }
    };
    const req = () => { if (!rf) rf = requestAnimationFrame(paintRow); };
    row.addEventListener('scroll', req, { passive: true });
    addEventListener('resize', req);
    phone.addEventListener('change', req);
    dots.forEach((d, i) => d.addEventListener('click', () => {
      row.scrollTo({ left: cards[i].offsetLeft - cards[0].offsetLeft, behavior: RM ? 'auto' : 'smooth' });
    }));
    paintRow();
  }
</script>
