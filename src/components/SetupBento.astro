---
// "Shaped to your team" bento: what we set up before day one, each card with a small live visual.
//  - Your names for things (tall, left): field labels retype themselves from generic words to the team's words
//  - Bring your spreadsheets: cells move from old files into one clean list
//  - Hosted where you prefer: a switch cycles through hosting options (clickable)
// Animations run only while the section is on screen and are off for reduced motion.
import Icon from './Icon.astro';

const pairs = [
  { a: 'Projects', b: 'Styles' },
  { a: 'Client', b: 'Buyer' },
  { a: 'Vendor', b: 'Mill' },
  { a: 'Stage', b: 'Fitting' },
  { a: 'Due date', b: 'Ex-factory' },
];
const hosting = [
  { label: 'Our cloud', note: 'We run it, with updates and backups included.' },
  { label: 'Your cloud', note: 'Set up in your own AWS, Azure or Google account.' },
  { label: 'On-site', note: 'On your own servers, inside your network.' },
];
---
<div class="bento" data-bento>
  <article class="bx bx-names">
    <div class="vis names-vis">
      <div class="nwin">
        <div class="nbar"><i></i><i></i><i></i><span class="nmode" data-mode>Your team's words</span></div>
        <div class="ncrumb"><span class="w yours" data-a={pairs[0].a} data-b={pairs[0].b}>{pairs[0].b}</span><span class="sep">/</span>Spring 2027</div>
        <h4 class="ntitle">Wrap dress SS27</h4>
        <dl>
          <div><dt><span class="w yours" data-a={pairs[1].a} data-b={pairs[1].b}>{pairs[1].b}</span></dt><dd>Nordic Stores</dd></div>
          <div><dt><span class="w yours" data-a={pairs[2].a} data-b={pairs[2].b}>{pairs[2].b}</span></dt><dd>Lumen Textiles</dd></div>
          <div><dt><span class="w yours" data-a={pairs[3].a} data-b={pairs[3].b}>{pairs[3].b}</span></dt><dd><span class="npill">2nd round</span></dd></div>
          <div><dt><span class="w yours" data-a={pairs[4].a} data-b={pairs[4].b}>{pairs[4].b}</span></dt><dd class="mono">14 Oct</dd></div>
        </dl>
      </div>
    </div>
    <div class="txt"><h3>Your names for things</h3><p>Your seasons, your stages, your categories. The system speaks your team's language.</p></div>
  </article>

  <article class="bx bx-sheets">
    <div class="vis sheets-vis" aria-hidden="true">
      <div class="files">
        <span class="file" style="--r:-4deg"><Icon name="sheet" />final_v3.xlsx</span>
        <span class="file" style="--r:3deg"><Icon name="sheet" />orders NEW.xlsx</span>
        <span class="file" style="--r:-2deg"><Icon name="sheet" />samples (2).xlsx</span>
      </div>
      <div class="flow"><i style="--d:0s"></i><i style="--d:.8s"></i><i style="--d:1.6s"></i></div>
      <div class="clean">
        <div class="crow" style="--d:0s"><b style="background:var(--ok-2)"></b><span></span><em>Approved</em></div>
        <div class="crow" style="--d:.8s"><b style="background:var(--info)"></b><span></span><em>In transit</em></div>
        <div class="crow" style="--d:1.6s"><b style="background:var(--warn-2)"></b><span></span><em>Ordered</em></div>
      </div>
    </div>
    <div class="txt"><h3>Bring your spreadsheets</h3><p>Start fresh, import your existing sheets, or let us move everything over once.</p></div>
  </article>

  <article class="bx bx-host">
    <div class="vis host-vis">
      <div class="seg" role="group" aria-label="Hosting options" style="--i:0">
        <span class="pill" aria-hidden="true"></span>
        {hosting.map((h, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-note={h.note}>{h.label}</button>)}
      </div>
      <p class="hnote" aria-live="polite">{hosting[0].note}</p>
    </div>
    <div class="txt"><h3>Hosted where you prefer</h3><p>In our cloud, in yours, or on your own servers. Priced before anything starts.</p></div>
  </article>

</div>

<style>
  .bento { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 20px }
  .bx { display: flex; flex-direction: column; gap: 22px; padding: 12px 12px 28px; border: 1px solid var(--line); border-radius: 24px; background: var(--surface) }
  .bx-names { grid-row: span 2 }
  .vis { position: relative; overflow: hidden; border-radius: 16px; background: var(--tint); min-height: 190px }
  .txt { display: flex; flex-direction: column; gap: 10px; padding: 0 16px }
  h3 { font: 600 clamp(20px, 1.8vw, 23px)/1.3 var(--body) }
  .txt p { margin: 0; font-size: 16px; line-height: 1.6; color: var(--body-ink); max-width: 46ch }
  .mono { font-family: var(--mono); font-size: .92em }

  /* names: a record whose labels retype */
  .names-vis { flex: 1; display: grid; place-items: center; padding: 32px 24px; background: radial-gradient(70% 55% at 30% 20%, color-mix(in srgb, var(--surface) 60%, transparent), transparent 70%), linear-gradient(150deg, var(--pn-1) 0%, var(--pn-2) 55%, var(--pn-3) 100%) }
  .nwin { width: min(100%, 360px); padding: 16px 20px 20px; border-radius: 18px; background: var(--surface); box-shadow: 0 24px 50px color-mix(in srgb, var(--navy) 16%, transparent) }
  .nbar { display: flex; align-items: center; gap: 6px; margin-bottom: 18px }
  .nbar i { width: 8px; height: 8px; border-radius: 50%; background: var(--n-200) }
  .nmode { margin-left: auto; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 99px; background: var(--tint-6); color: var(--brand-2); transition: background-color .3s, color .3s }
  .nmode.generic { background: var(--n-100); color: var(--mid) }
  .ncrumb { font-size: 13px; color: var(--mid) }
  .sep { margin: 0 6px; color: var(--n-400) }
  .ntitle { margin: 6px 0 14px; font: 600 19px/1.25 var(--display); color: var(--ink) }
  dl { margin: 0 }
  dl > div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--n-100); font-size: 14px }
  dt { color: var(--mid) }
  dd { margin: 0; color: var(--ink) }
  .npill { display: inline-block; padding: 3px 10px; border-radius: 99px; background: var(--tint-6); color: var(--brand-2); font-size: 12.5px; font-weight: 600 }
  .w { display: inline-block; min-height: 1.2em; padding: 0 .2em; margin: 0 -.2em; border-radius: 5px; white-space: nowrap; transition: background-color .3s, color .3s }
  .w.yours { background: var(--soft-2); color: var(--brand-2); font-weight: 600 }
  .w.typing::after { content: ""; display: inline-block; width: 1.5px; height: 1em; margin-left: 1px; vertical-align: -.12em; background: currentColor; animation: caret .8s steps(1) infinite }
  @keyframes caret { 50% { opacity: 0 } }

  /* sheets: old files on the left feed one clean list on the right */
  .sheets-vis { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr) minmax(0, 1fr); align-items: center; gap: 0; padding: 26px 28px; container-type: inline-size }
  .files { display: flex; flex-direction: column; gap: 10px; align-items: flex-start }
  .file { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px 8px 9px; border-radius: 10px; background: var(--surface); box-shadow: 0 6px 16px color-mix(in srgb, var(--navy) 8%, transparent); font: 12.5px var(--mono); color: var(--body-ink); transform: rotate(var(--r)); white-space: nowrap }
  .file :global(svg) { width: 16px; height: 16px; color: var(--ok-2) }
  .flow { position: relative; height: 100%; min-height: 120px }
  .flow::before { content: ""; position: absolute; left: 8%; right: 8%; top: 50%; border-top: 2px dashed var(--rule-2) }
  .flow i { position: absolute; top: calc(50% - 7px); left: 4%; width: 22px; height: 14px; border-radius: 4px; background: var(--surface); border: 1.5px solid var(--g1); opacity: 0; animation: cell 2.4s cubic-bezier(.5, 0, .3, 1) var(--d) infinite }
  @keyframes cell { 0% { opacity: 0; transform: translateX(0) } 15% { opacity: 1 } 80% { opacity: 1 } 100% { opacity: 0; transform: translateX(23cqw) } }
  .clean { display: flex; flex-direction: column; gap: 8px; padding: 14px; border-radius: 14px; background: var(--surface); box-shadow: 0 14px 30px color-mix(in srgb, var(--navy) 12%, transparent) }
  .crow { display: grid; grid-template-columns: 8px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 6px 2px; animation: rowin 2.4s ease-out var(--d) infinite }
  .crow b { width: 8px; height: 8px; border-radius: 50% }
  .crow span { height: 7px; border-radius: 4px; background: var(--n-200) }
  .crow em { font-style: normal; font-size: 11.5px; font-weight: 600; color: var(--body-ink) }
  @keyframes rowin { 0%, 70% { background: transparent } 85% { background: var(--tint-5) } 100% { background: transparent } }

  /* hosting: segmented switch */
  .host-vis { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 16px; padding: 24px 20px }
  .host-vis .seg { width: min(100%, 420px) }
  .seg { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 4px; border-radius: 14px; background: var(--surface); box-shadow: 0 6px 16px color-mix(in srgb, var(--navy) 8%, transparent) }
  .pill { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc((100% - 8px) / 3); border-radius: 10px; background: var(--navy); transform: translateX(calc(var(--i) * 100%)); transition: transform .5s cubic-bezier(.2, .7, .2, 1) }
  .seg button { position: relative; z-index: 1; border: 0; background: none; padding: 10px 4px; font: 500 13px var(--body); color: var(--body-ink); cursor: pointer; white-space: nowrap; transition: color .3s }
  .seg button[aria-pressed="true"] { color: var(--surface) }
  .hnote { margin: 0; min-height: 2.9em; font-size: 13.5px; line-height: 1.45; color: var(--body-ink); text-align: center; transition: opacity .25s }
  .hnote.out { opacity: 0 }

  /* pause CSS loops while off screen */
  .bento:not(.live) .flow i, .bento:not(.live) .crow { animation-play-state: paused }

  @media (max-width: 980px) {
    .bento { grid-template-columns: minmax(0, 1fr) }
    .bx-names { grid-row: auto }
    .names-vis { min-height: 340px }
  }
  @media (max-width: 560px) {
    .sheets-vis { grid-template-columns: minmax(0, 1fr); gap: 14px }
    .flow { display: none }
    .files { flex-direction: row; flex-wrap: wrap }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow i, .crow, .w.typing::after { animation: none !important }
    .flow i { opacity: 1; left: 40% }
    .pill, .hnote { transition: none }
  }
</style>

<script>
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-bento]').forEach((root) => {
    let visible = false;
    const waitVisible = async () => { while (!visible) await sleep(200); };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      root.classList.toggle('live', visible);
    }, { threshold: 0.2 }).observe(root);

    /* --- hosting switch: auto-cycles until someone clicks an option --- */
    const seg = root.querySelector<HTMLElement>('.seg')!;
    const btns = Array.from(seg.querySelectorAll<HTMLButtonElement>('button'));
    const note = root.querySelector<HTMLElement>('.hnote')!;
    let current = 0;
    let manual = false;
    const pick = (i: number) => {
      current = i;
      seg.style.setProperty('--i', String(i));
      btns.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
      note.classList.add('out');
      setTimeout(() => { note.textContent = btns[i].dataset.note ?? ''; note.classList.remove('out'); }, reduced ? 0 : 200);
    };
    btns.forEach((b, i) => b.addEventListener('click', () => { manual = true; pick(i); }));
    if (!reduced) {
      (async () => {
        for (;;) {
          await sleep(2600);
          await waitVisible();
          if (manual) return;
          pick((current + 1) % btns.length);
        }
      })();
    }

    /* --- names: labels retype between generic words and the team's words --- */
    if (reduced) return;
    const words = Array.from(root.querySelectorAll<HTMLElement>('.w'));
    const mode = root.querySelector<HTMLElement>('[data-mode]')!;
    const retype = async (el: HTMLElement, to: string, yours: boolean) => {
      el.classList.add('typing');
      el.classList.remove('yours');
      while (el.textContent!.length) { el.textContent = el.textContent!.slice(0, -1); await sleep(32); }
      for (const ch of to) { el.textContent += ch; await sleep(55); }
      el.classList.remove('typing');
      el.classList.toggle('yours', yours);
    };
    const setAll = (yours: boolean) => {
      mode.textContent = yours ? "Your team's words" : 'Generic words';
      mode.classList.toggle('generic', !yours);
      return Promise.all(words.map(async (w, k) => {
        await sleep(k * 180);
        await retype(w, yours ? w.dataset.b! : w.dataset.a!, yours);
      }));
    };
    // Start from the generic words (instantly, before the section is seen), then keep switching.
    words.forEach((w) => { w.textContent = w.dataset.a!; w.classList.remove('yours'); });
    mode.textContent = 'Generic words';
    mode.classList.add('generic');
    (async () => {
      for (;;) {
        await waitVisible();
        await sleep(900);
        await setAll(true);
        await sleep(3200);
        await waitVisible();
        await setAll(false);
        await sleep(1400);
      }
    })();
  });
</script>
