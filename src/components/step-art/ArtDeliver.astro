---
// Step art: a passed final inspection, a delivered shipment and an export button.
---
<svg class="art" viewBox="0 0 300 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <defs>
    <filter id="sa4-sh" filterUnits="userSpaceOnUse" x="-60" y="-60" width="420" height="540" color-interpolation-filters="sRGB"><feDropShadow dx="0" dy="12" stdDeviation="12" flood-color="#1A2340" flood-opacity=".18" /></filter>
    <filter id="sa4-bl"><feGaussianBlur stdDeviation="7" /></filter>
  </defs>
  <g class="cloud" filter="url(#sa4-bl)"><circle cx="250" cy="40" r="42" /><circle cx="214" cy="24" r="28" /><circle cx="60" cy="372" r="40" /></g>

  <g class="fl" style="--d:0s"><g filter="url(#sa4-sh)"><g transform="rotate(-4 150 123)">
    <rect x="34" y="64" width="232" height="120" rx="18" fill="#fff" />
    <circle cx="68" cy="100" r="16" fill="#E3F1E6" />
    <path d="M61 100l5 5 9-10" fill="none" stroke="#2F6B45" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    <text x="94" y="97" font-size="13.5" font-weight="600" fill="#12182A">Final inspection</text>
    <text x="94" y="114" font-size="11.5" fill="#6F7689">Passed, ready to ship</text>
    <rect x="52" y="136" width="196" height="8" rx="4" fill="#3F7D5C" />
    <text x="52" y="166" font-size="11" fill="#6F7689">Checklist</text>
    <text class="mono" x="248" y="166" text-anchor="end" font-size="11" fill="#12182A">12/12</text>
  </g></g></g>

  <g class="fl" style="--d:.12s"><g filter="url(#sa4-sh)"><g transform="rotate(3 163 258)">
    <rect x="50" y="206" width="226" height="104" rx="18" fill="#fff" />
    <rect x="68" y="226" width="42" height="42" rx="11" fill="#EEF0FB" />
    <g transform="translate(72 230) scale(1.4)" fill="none" stroke="#1A2340" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v9H3zM14 10h4l3 3v2h-7" /><circle cx="7" cy="17" r="2" /><circle cx="17" cy="17" r="2" /></g>
    <text x="124" y="243" font-size="13.5" font-weight="600" fill="#12182A">Delivered</text>
    <text x="124" y="261" font-size="11.5" fill="#6F7689">02 Dec · 2 parcels</text>
    <rect x="124" y="274" width="62" height="20" rx="10" fill="#E3F1E6" />
    <text x="155" y="287.5" text-anchor="middle" font-size="10.5" font-weight="600" fill="#2F6B45">On time</text>
  </g></g></g>

  <g class="fl" style="--d:.24s"><g filter="url(#sa4-sh)">
    <rect x="148" y="334" width="124" height="34" rx="17" fill="#1A2340" />
    <path d="M168 344v11M163 350l5 5 5-5" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    <text x="182" y="355.5" font-size="12.5" font-weight="600" fill="#fff">Export list</text>
  </g></g>
</svg>
