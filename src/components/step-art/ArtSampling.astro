---
// Step art: a sampling timeline that ticks itself off, with the next due date.
---
<svg class="art" viewBox="0 0 300 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  <defs>
    <filter id="sa3-sh" filterUnits="userSpaceOnUse" x="-60" y="-60" width="420" height="540" color-interpolation-filters="sRGB"><feDropShadow dx="0" dy="12" stdDeviation="12" flood-color="#1A2340" flood-opacity=".18" /></filter>
    <filter id="sa3-bl"><feGaussianBlur stdDeviation="7" /></filter>
  </defs>
  <g class="cloud" filter="url(#sa3-bl)"><circle cx="70" cy="350" r="44" /><circle cx="30" cy="320" r="30" /><circle cx="110" cy="372" r="28" /></g>

  <g class="fl" style="--d:0s"><g filter="url(#sa3-sh)"><g transform="rotate(3 150 205)">
    <rect x="40" y="70" width="220" height="270" rx="18" fill="#fff" />
    <text x="60" y="103" font-size="14" font-weight="600" fill="#12182A">Sampling</text>
    <rect x="158" y="89" width="86" height="20" rx="10" fill="#FBF0DC" />
    <text x="201" y="102.5" text-anchor="middle" font-size="10" font-weight="600" fill="#8A5A12">Due in 3 days</text>
    <line x1="70" y1="140" x2="70" y2="240" stroke="#3F7D5C" stroke-width="2" />
    <line x1="70" y1="240" x2="70" y2="300" stroke="#E1E4EA" stroke-width="2" />
    <g>
      <circle cx="70" cy="140" r="9" fill="#3F7D5C" /><path d="M66 140l3 3 5-6" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <text x="92" y="139" font-size="13" font-weight="600" fill="#12182A">Proto sent</text>
      <text class="mono" x="92" y="154" font-size="10.5" fill="#6F7689">08 Sep</text>
    </g>
    <g>
      <circle cx="70" cy="190" r="9" fill="#3F7D5C" /><path d="M66 190l3 3 5-6" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <text x="92" y="189" font-size="13" font-weight="600" fill="#12182A">Fit sample</text>
      <text class="mono" x="92" y="204" font-size="10.5" fill="#6F7689">22 Sep</text>
    </g>
    <g>
      <circle cx="70" cy="240" r="15" fill="#1A2340" fill-opacity=".1" />
      <circle cx="70" cy="240" r="9" fill="#fff" stroke="#1A2340" stroke-width="2" /><circle cx="70" cy="240" r="3.5" fill="#1A2340" />
      <text x="92" y="239" font-size="13" font-weight="600" fill="#12182A">Size set</text>
      <text x="92" y="254" font-size="10.5" fill="#1A2340">Now</text>
    </g>
    <g>
      <circle cx="70" cy="300" r="9" fill="#fff" stroke="#CFD4DD" stroke-width="2" />
      <text x="92" y="299" font-size="13" font-weight="600" fill="#6F7689">Approved</text>
      <text class="mono" x="92" y="314" font-size="10.5" fill="#6F7689">ETA 14 Oct</text>
    </g>
  </g></g></g>

  <g class="fl" style="--d:.12s"><g filter="url(#sa3-sh)">
    <rect x="22" y="34" width="112" height="32" rx="16" fill="#fff" />
    <circle cx="40" cy="50" r="4.5" fill="#3F7D5C" />
    <text x="52" y="54.5" font-size="12" font-weight="600" fill="#12182A">2 of 4 done</text>
  </g></g>

  <g class="fl" style="--d:.24s"><g filter="url(#sa3-sh)"><g transform="rotate(-6 236 352)">
    <rect x="202" y="318" width="70" height="68" rx="16" fill="#1A2340" />
    <text x="237" y="342" text-anchor="middle" font-size="10" font-weight="600" letter-spacing="1.5" fill="#C9D3EE">OCT</text>
    <text x="237" y="372" text-anchor="middle" font-size="26" font-weight="600" fill="#fff">14</text>
  </g></g></g>
</svg>
